<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
    <!-- Android host (SdlVulkanActivity) needs SDL3-CS.Android's Java bridge, which only exists on
         the android TFM. Desktop keeps the SDL3-CS.Native path via consuming apps. -->
    <SupportedOSPlatformVersion Condition="'$(TargetFramework)' == 'net10.0-android'">24.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageID>SdlVulkan.Renderer</PackageID>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/SharpAstro/SdlVulkan.Renderer.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!--
    DIR.Lib (rendering primitives + font rasterization) is referenced via
    ProjectReference when a sibling working copy exists, so iteration can
    happen in-tree. CI / package builds without the sibling fall through
    to PackageReference automatically.
  -->
  <PropertyGroup>
    <UseLocalDirLib Condition="'$(UseLocalDirLib)' == '' AND Exists('..\..\..\DIR.Lib\src\DIR.Lib\DIR.Lib.csproj')">true</UseLocalDirLib>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalDirLib)' == 'true'">
    <ProjectReference Include="..\..\..\DIR.Lib\src\DIR.Lib\DIR.Lib.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalDirLib)' != 'true'">
    <PackageReference Include="DIR.Lib" />
  </ItemGroup>

  <ItemGroup>
    <!-- SDL3-CS publishes preview versions only, so NuGet's stable-package-with-prerelease-dependency
         warning (NU5104) fires on every pack; suppressed for this reference alone. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="SDL3-CS" NoWarn="NU5104" />
    <PackageReference Include="Vortice.Vulkan" />
  </ItemGroup>

  <!--
    Shaders are authored as GLSL 450 in Shaders/*.vert|*.frag and pre-baked to SPIR-V under
    Shaders/spirv/*.spv by the tools/BakeShaders tool (committed). The renderer embeds the .spv and
    loads it at runtime, so the shipped package carries NO shaderc dependency (it has no Android RID)
    and does NO runtime GLSL to SPIR-V compilation. Re-bake and commit the .spv when a shader
    changes (see the SVR0001 build warning below for the exact command; also tools/BakeShaders).
    (.vert/.frag are already visible in the IDE via the SDK's default None glob.)
  -->
  <ItemGroup>
    <None Remove="Shaders\spirv\*.spv" />
    <EmbeddedResource Include="Shaders\spirv\*.spv">
      <LogicalName>SdlVulkan.Renderer.Shaders.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <ShaderSource Include="Shaders\*.vert;Shaders\*.frag" />
  </ItemGroup>

  <!-- Warn (never fail) when a shader source no longer matches what it was baked from, so an edit that
       forgets to re-bake is visible.

       Compares CONTENT, against the hashes tools/BakeShaders recorded when it last ran. This replaced a
       timestamp comparison, which a fresh checkout scrambles: git writes files in index order, so every
       source sorting after `spirv/` (stroke.*, tex.*) lands newer than its own .spv and the warning fired
       on every CI build while never being able to catch a real one. Hashes are reproducible from any
       checkout, so a missing re-bake is now caught in CI too. Shaders/.gitattributes keeps the bytes
       identical everywhere, which is what makes the hash portable. -->
  <Target Name="WarnStaleBakedShaders" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_BakedShaderManifest>Shaders\spirv\sources.sha256</_BakedShaderManifest>
      <_BakeShadersCommand>dotnet run --project tools/BakeShaders -c Release -- src/SdlVulkan.Renderer/Shaders</_BakeShadersCommand>
    </PropertyGroup>

    <GetFileHash Files="@(ShaderSource)" MetadataName="SourceHash" HashEncoding="hex"
                 Condition="Exists('$(_BakedShaderManifest)')">
      <Output TaskParameter="Items" ItemName="_HashedShaderSource" />
    </GetFileHash>
    <ReadLinesFromFile File="$(_BakedShaderManifest)" Condition="Exists('$(_BakedShaderManifest)')">
      <Output TaskParameter="Lines" ItemName="_BakedShaderLine" />
    </ReadLinesFromFile>

    <ItemGroup>
      <!-- Join the two sides by content: each carries the manifest's `name=hash` line as metadata, so
           Remove/MatchOnMetadata leaves exactly the sources whose line the manifest does not have: a
           changed shader, or one that was never baked. Survivors keep the source path as their identity,
           which is what the warning goes on to name. -->
      <_ShaderBakeLine Include="@(_HashedShaderSource)">
        <BakeLine>%(Filename)%(Extension)=%(SourceHash)</BakeLine>
      </_ShaderBakeLine>
      <_BakedShaderHash Include="@(_BakedShaderLine)">
        <BakeLine>%(Identity)</BakeLine>
      </_BakedShaderHash>
      <_StaleShader Include="@(_ShaderBakeLine)" />
      <_StaleShader Remove="@(_BakedShaderHash)" MatchOnMetadata="BakeLine" />
    </ItemGroup>

    <Warning Code="SVR0001" Condition="!Exists('$(_BakedShaderManifest)')"
             Text="No baked-shader manifest ($(_BakedShaderManifest)), so whether Shaders/spirv/*.spv is current cannot be told; re-run '$(_BakeShadersCommand)'." />
    <Warning Code="SVR0001" Condition="'@(_StaleShader)' != ''"
             Text="Shader source(s) changed since they were baked; re-run '$(_BakeShadersCommand)' and commit Shaders/spirv/*.spv plus $(_BakedShaderManifest). Stale: @(_StaleShader)" />
  </Target>

  <!-- Android-only: SDL Java bridge (Org.Libsdl.App.SDLActivity) + per-ABI libSDL3.so natives. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <PackageReference Include="SDL3-CS.Android" />
  </ItemGroup>

  <!-- The Android host (Android/*.cs) uses Org.Libsdl.App and compiles only for the android TFM. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-android'">
    <Compile Remove="Android/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The inspector's request parsing decides what an injected key or click MEANS, and getting that wrong
         looks like the app misbehaving rather than like a bad request. Reachable only through a live SDL
         window otherwise, so the test project checks the resolvers directly. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>SdlVulkan.Renderer.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
