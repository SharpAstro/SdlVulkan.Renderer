<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Platforms>AnyCPU</Platforms>
    <!-- BlendOpRegressionTests construct VkInstance + push constants via Vortice.Vulkan, which
         needs unsafe pointer handling. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Package versions come from src/Directory.Packages.props, which covers this project because it
         sits at src/ rather than beside the library. While it lived at src/SdlVulkan.Renderer/ this
         project was outside its scope and had to opt out of central management and pin inline. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Vortice.Vulkan is a transitive of the renderer ProjectReference but we use its types
         (VkInstance, VkBlendOp etc.) directly in the test, so reference it explicitly. One version for
         both, from src/Directory.Packages.props — which is the point of that file covering the whole
         src/ tree. Two versions is what fails restore outright on NU1605, a downgrade from the lib's
         transitive. -->
    <PackageReference Include="Vortice.Vulkan" />
    <!-- ClickThroughHintTests call SDL_GetHint/SDL_SetHint, which load the SDL3 native library; the renderer
         leaves that to the consuming app, so the test project brings it. -->
    <PackageReference Include="SDL3-CS.Native" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SdlVulkan.Renderer\SdlVulkan.Renderer.csproj" />
    <ProjectReference Include="..\SdlVulkan.Renderer.Inspector\SdlVulkan.Renderer.Inspector.csproj" />
    <ProjectReference Include="..\SdlVulkan.Renderer.Inspector.Client\SdlVulkan.Renderer.Inspector.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- IosFrameworksTargetsTests evaluates the package's iOS targets as an app would import them. Copied rather than
         found through [CallerFilePath], which a ContinuousIntegrationBuild maps to /_/. -->
    <Content Include="..\SdlVulkan.Renderer\buildTransitive\**" LinkBase="buildTransitive" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The page and the measuring of tools/SlugProbe, compiled here too so SlugProbeSmokeTests runs the very code the
         probe runs by hand (the probe is not in the solution, so nothing else would build it on CI). -->
    <Compile Include="..\..\tools\SlugProbe\SlugProbePage.cs" Link="SlugProbe\SlugProbePage.cs" />
  </ItemGroup>

</Project>
