<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Platforms>AnyCPU</Platforms>
    <!-- BlendOpRegressionTests construct VkInstance + push constants via Vortice.Vulkan, which
         needs unsafe pointer handling. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The lib's csproj uses central package versions via its own Directory.Packages.props,
         but the test project sits outside that file's directory and would not inherit it.
         Disable central management here so we can pin test-framework versions inline without
         duplicating the lib's package list. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Vortice.Vulkan is a transitive of the renderer ProjectReference but we use its types
         (VkInstance, VkBlendOp etc.) directly in the test, so pin it explicitly. This project sits
         outside src/SdlVulkan.Renderer/, so it is out of that Directory.Packages.props' scope and
         states the version inline — it has to be bumped in step with the lib, or restore fails the
         build outright on NU1605 (a downgrade from the lib's transitive). -->
    <PackageReference Include="Vortice.Vulkan" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SdlVulkan.Renderer\SdlVulkan.Renderer.csproj" />
    <ProjectReference Include="..\SdlVulkan.Renderer.Inspector\SdlVulkan.Renderer.Inspector.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
