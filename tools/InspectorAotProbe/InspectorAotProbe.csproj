<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Manual tool (not in CI, not in the solution): proves that a NativeAOT app on the renderer has no debug inspector
    unless it is published with -p:DirInspectorSupport=true (DIR.Lib's DIR.Lib.Inspector.IsSupported feature switch,
    which DebugInspector.Attach follows; issue #182). Headless: no SDL, no window, no Vulkan. Sits outside src/, so
    Central Package Management does not apply; DIR.Lib arrives through the renderer's own PackageReference, and so do
    its buildTransitive targets that turn the switch off for a trimmed publish.

    Run (Git Bash needs the VS Installer folder on PATH first, or the link step fails MSB3073 on vswhere):
      dotnet publish tools/InspectorAotProbe/InspectorAotProbe.csproj -c Release -r win-x64 -p:NoAttach=true -p:IlcGenerateMapFile=true -o OUT1
      dotnet publish tools/InspectorAotProbe/InspectorAotProbe.csproj -c Release -r win-x64 -p:IlcGenerateMapFile=true -o OUT2
      dotnet publish tools/InspectorAotProbe/InspectorAotProbe.csproj -c Release -r win-x64 -p:DirInspectorSupport=true -p:IlcGenerateMapFile=true -o OUT3
      dotnet publish tools/InspectorAotProbe/InspectorAotProbe.csproj -c Release -r win-x64 -p:RefsOnly=true -p:IlcGenerateMapFile=true -o OUT4
    OUT1 has no Attach call (the baseline), OUT2 has the call with the switch at its publish default (off), OUT3
    keeps the inspector, OUT4 names the same renderer types as OUT2 (SdlEventLoop, SdlWindowView) and prints the same
    line but does not call Attach: OUT2 minus OUT4 is what Attach itself costs. Compare the .exe sizes and grep the map
    files (obj/.../native/*.map.xml) for DebugInspector, then run OUT2 and OUT3 with DIR_INSPECTOR=1
    DIR_INSPECTOR_TOKEN=x. Measured (win-x64, 7.97): OUT1 1,166,336 bytes, OUT4 1,199,616, OUT2 1,202,176, OUT3
    2,865,664; see CHANGELOG 7.97. Diff two map files by their MethodCode entries per name, not by name alone (a
    GCInfo entry shares its method's name).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <DefineConstants Condition="'$(NoAttach)' == 'true'">$(DefineConstants);NO_ATTACH</DefineConstants>
    <DefineConstants Condition="'$(RefsOnly)' == 'true'">$(DefineConstants);REFS_ONLY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SdlVulkan.Renderer\SdlVulkan.Renderer.csproj" />
  </ItemGroup>

</Project>
